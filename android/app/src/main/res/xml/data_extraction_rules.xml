<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- 앱 번들에서 다시 만드는 읽기 전용 정류장 DB와 API 캐시는 전송하지 않는다. -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="BusRouteCache.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="BusRouteCache.xml" />
    </device-transfer>
</data-extraction-rules>
